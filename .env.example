# ── Docker Compose ──
COMPOSE_PROJECT_NAME=projectseight

# ── Database (dipakai docker compose) ──
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=projectseight
POSTGRES_PORT=5432

# ── API (NestJS + Drizzle) ──
API_PORT=4000
DATABASE_URL=postgresql://app:app@localhost:5432/projectseight
WEB_URL=http://localhost:3000

# ── Web (Next.js) ──
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
